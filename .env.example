APP_ENV=local
PORT=8080
LOG_LEVEL=info

# Use postgres://...@localhost:... when running the API directly on your host
# (Postgres in Docker, Go on host). docker-compose.yml overrides this to use
# the in-network host "postgres" when running the full stack with `docker compose up`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/click_collect?sslmode=disable
